# ==============================================
# Quivr ETL Pipeline Configuration
# ==============================================

# Supabase (Source Database) Configuration
SUPABASE_HOST=localhost
SUPABASE_PORT=54322
SUPABASE_DATABASE=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=postgres
SUPABASE_SCHEMA=public

# SQL Server (Target Data Warehouse) Configuration
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=DataWarehouse
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=YourPassword123!
SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server

# ETL Performance Configuration
BATCH_SIZE=1000
LOG_LEVEL=INFO
SYNC_INTERVAL_MINUTES=60
MAX_RETRIES=3
RETRY_DELAY=5
PARALLEL_WORKERS=4
CONNECTION_POOL_SIZE=10

# ==============================================
# Optional: Email Notifications
# ==============================================
# ETL_SMTP_SERVER=smtp.gmail.com
# ETL_SMTP_PORT=587
# ETL_SMTP_USERNAME=your-email@gmail.com
# ETL_SMTP_PASSWORD=your-app-password
# ETL_FROM_EMAIL=your-email@gmail.com
# ETL_TO_EMAILS=admin1@company.com,admin2@company.com

# ==============================================
# Optional: Slack Notifications
# ==============================================
# ETL_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# ==============================================
# Advanced Configuration
# ==============================================

# Table Sync Configuration (JSON format)
# SYNC_TABLES=["users","brains","chats","chat_history","vectors","knowledge","api_keys","user_settings","notifications","prompts","brains_users","brains_vectors","knowledge_vectors","user_daily_usage"]

# Incremental Sync Tables (JSON format)
# INCREMENTAL_TABLES={"chat_history":"message_time","chats":"creation_time","notifications":"datetime","user_daily_usage":"date","vectors":"id","knowledge":"id"}

# Exclude Columns Configuration (JSON format)
# EXCLUDE_COLUMNS={"api_keys":["api_key"],"users":[]}

# Security Configuration
# ETL_API_KEY=your-secret-api-key-for-monitoring-interface
# ETL_SECRET_KEY=your-secret-key-for-encryption

# Monitoring Configuration
# ENABLE_METRICS=true
# METRICS_PORT=9090
# ENABLE_WEB_INTERFACE=true
# WEB_INTERFACE_PORT=8080 